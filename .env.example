# Create an application at https://my.telegram.org/apps
API_ID=
API_HASH=
# Leave SESSION empty before first QR login; the script fills it locally.
SESSION=
# Active Telegram group voice chat and a local media file to stream.
CHAT_ID=
FILE=
# Optional video settings for FILE. Audio only is used by default.
VIDEO=false
# Set to true to use Telegram's presentation channel instead of camera video.
PRESENTATION=false
# A tested starting point for smooth playback: 854x480 at 30 FPS.
VIDEO_WIDTH=854
VIDEO_HEIGHT=480
VIDEO_FPS=30
