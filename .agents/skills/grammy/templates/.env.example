# .env.example
# Salin file ini ke .env dan isi dengan nilai yang sesuai.

# Token Bot Telegram (dapatkan dari @BotFather)
BOT_TOKEN=your_bot_token_here

# Konfigurasi Database (jika menggunakan session Redis/MongoDB)
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/telegram_bot

# Port untuk webhook (jika menggunakan webhook)
PORT=3000