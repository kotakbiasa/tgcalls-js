{
  "name": "tgcalls-js",
  "version": "0.4.0",
  "description": "Modern Telegram voice, video, 1-on-1 P2P call, RTMP livestream, E2E conference & Gemini Live Voice AI SDK for Node.js (ntgcalls + teleproto/GramJS/mtcute).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck:all": "tsc -p tsconfig.all.json",
    "test": "node test/all.mjs",
    "smoke": "node smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck:all && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotakbiasa/tgcalls-js.git"
  },
  "bugs": {
    "url": "https://github.com/kotakbiasa/tgcalls-js/issues"
  },
  "homepage": "https://tgcalls-js.gitbook.io/docs/",
  "keywords": [
    "telegram",
    "userbot",
    "voice-chat",
    "group-call",
    "p2p-call",
    "video-call",
    "rtmp",
    "conference",
    "voice-ai",
    "gemini-live",
    "webrtc",
    "pytgcalls",
    "tgcalls",
    "ntgcalls",
    "gramjs",
    "teleproto",
    "mtcute",
    "vc"
  ],
  "author": "kotakbiasa",
  "license": "MIT",
  "dependencies": {
    "ntgcalls": "3.0.7"
  },
  "peerDependencies": {
    "big-integer": ">=1.6"
  },
  "peerDependenciesMeta": {
    "big-integer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mtcute/node": "^0.32.8",
    "@types/node": "^26.6.6",
    "teleproto": "^1.233.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
