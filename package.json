{
  "name": "tgcalls-js",
  "version": "0.2.0",
  "description": "pytgcalls-style Telegram group call wrapper for Node.js (GramJS/teleproto + ntgcalls). Stream audio into Telegram voice chats.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx test/run.ts",
    "smoke": "node smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotakbiasa/tgcalls-js.git"
  },
  "bugs": {
    "url": "https://github.com/kotakbiasa/tgcalls-js/issues"
  },
  "homepage": "https://github.com/kotakbiasa/tgcalls-js#readme",
  "keywords": [
    "telegram",
    "userbot",
    "voice-chat",
    "group-call",
    "pytgcalls",
    "tgcalls",
    "ntgcalls",
    "gramjs",
    "teleproto",
    "vc"
  ],
  "author": "kotakbiasa",
  "license": "MIT",
  "dependencies": {
    "ntgcalls": "3.0.0-rc02"
  },
  "peerDependencies": {
    "big-integer": ">=1.6"
  },
  "peerDependenciesMeta": {
    "big-integer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
